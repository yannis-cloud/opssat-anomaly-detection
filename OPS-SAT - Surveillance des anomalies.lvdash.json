{
  "datasets": [
    {
      "name": "abc87dc3",
      "displayName": "Anomaly Detection Segments Summary Report",
      "config": {
        "version": "1.1",
        "source": "SELECT COUNT(*) AS segments,\r\n       SUM(alerte) AS alertes,\r\n       ROUND(100 * AVG(alerte), 1) AS pct_alertes,\r\n       MAX(version_modele) AS version_modele,\r\n       MAX(date_scoring) AS dernier_scoring\r\nFROM workspace.default.predictions_anomalies",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "93060f59",
      "displayName": "Channel Alert Statistics Summary",
      "queryLines": [
        "SELECT channel, COUNT(*) AS segments, SUM(alerte) AS alertes,\r\n",
        "       ROUND(100 * AVG(alerte), 1) AS pct_alertes\r\n",
        "FROM workspace.default.predictions_anomalies\r\n",
        "GROUP BY channel\r\n",
        "ORDER BY alertes DESC"
      ]
    },
    {
      "name": "c1718a26",
      "displayName": "Channel Anomaly Detection Summary Metrics Dataset",
      "queryLines": [
        "SELECT channel,\r\n",
        "       SUM(CASE WHEN alerte = 1 AND anomaly = 1 THEN 1 ELSE 0 END) AS bonnes_detections,\r\n",
        "       SUM(CASE WHEN alerte = 0 AND anomaly = 1 THEN 1 ELSE 0 END) AS anomalies_ratees,\r\n",
        "       SUM(CASE WHEN alerte = 1 AND anomaly = 0 THEN 1 ELSE 0 END) AS fausses_alertes\r\n",
        "FROM workspace.default.predictions_anomalies\r\n",
        "WHERE train = 0\r\n",
        "GROUP BY channel\r\n",
        "ORDER BY anomalies_ratees DESC"
      ]
    },
    {
      "name": "cee5a674",
      "displayName": "Top Anomaly Alerts By Segment And Channel",
      "queryLines": [
        "SELECT segment, channel, ROUND(proba_anomalie, 3) AS proba\r\n",
        "FROM workspace.default.predictions_anomalies\r\n",
        "WHERE alerte = 1\r\n",
        "ORDER BY proba_anomalie DESC\r\n",
        "LIMIT 50"
      ]
    }
  ],
